# ==============================================================================
# Environment Variables - PRODUCTION
# ==============================================================================
# Copy this file to .env on your EC2 instance and fill in the real values.
# NEVER commit .env to the repository.
# ==============================================================================

# ── Database (AWS RDS) ──────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/taskmanager
DATABASE_USERNAME=taskmanager_admin
DATABASE_PASSWORD=<STRONG_PASSWORD_HERE>

# ── Redis (AWS ElastiCache) ─────────────────────────────────────────
REDIS_HOST=<ELASTICACHE_ENDPOINT>
REDIS_PORT=6379

# ── JWT Secret (generate: openssl rand -base64 64) ─────────────────
JWT_SECRET=<GENERATE_A_64_CHAR_RANDOM_STRING>

# ── AWS Credentials ─────────────────────────────────────────────────
AWS_ACCESS_KEY=<YOUR_AWS_ACCESS_KEY>
AWS_SECRET_KEY=<YOUR_AWS_SECRET_KEY>
AWS_REGION=sa-east-1

# ── AWS S3 ──────────────────────────────────────────────────────────
S3_BUCKET_NAME=task-manager-storage-jonas

# ── AWS SES ─────────────────────────────────────────────────────────
AWS_SES_FROM=noreply@jonasmessias.dev.br

# ── Google OAuth2 ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>.apps.googleusercontent.com

# ── Frontend ────────────────────────────────────────────────────────
FRONTEND_URL=https://task-manager-app-angular.vercel.app
